@page
@using TachraFac.Datalayer.Entities.Product
@model TachraFac.Web.Pages.Admin.Product.AddMatreialModel
@{
	ViewData["Title"] = "افزودن مواد اولیه";
	List<RawMaterial> raw = ViewData["ProductMatreial"] as List<RawMaterial>;
}


<div id="page-wrapper">
	<div class="row">
		<div class="col-lg-12">
			<h1 class="page-header">لیست مواد اولیه</h1>
		</div>
		<!-- /.col-lg-12 -->
	</div>

	<div class="row">
		<div class="col-lg-12">
			<div class="panel panel-default">
				<div class="panel-heading">
					اطلاعات
				</div>
				<!-- /.panel-heading -->
				<div class="panel-body">
					<form method="post">
						<div class="form-group">
							<label>نام ماده اولیه</label>
							<input type="text" asp-for="rawMaterial.MaterialTitle" class="form-control">
						</div>
						<div asp-validation-summary="All"></div>

						<div class="col-md-4">
							<p>
								<input type="submit" value="ثبت" class="btn btn-success" />
							</p>
						</div>
					</form>
					
				</div>

				<div class="panel-body">
					<div class="table-responsive">
						<div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
							

							<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
								<thead>
									<tr>
										<th>مواد اولیه</th>
										<th>دستورات</th>
									</tr>
								</thead>
								<tbody>
									@if(raw != null)
									{
										@foreach (var matreial in raw)
										{
											<tr>
												<td>@matreial.MaterialTitle</td>
												<td>
													<a href="~/Admin/Product/EditMatreial/@matreial.MaterialId" class="btn btn-warning btn-sm">ویرایش</a>
													<a href="~/Admin/Product/DeleteMatreial/@matreial.MaterialId" class="btn btn-danger btn-sm">حذف</a>
												</td>
											</tr>
										}
									}
									else
									{
										<tr>
											<td colspan="2" class="text-center">موردی یافت نشد.</td>
										</tr>
									}
								</tbody>
							</table>

						</div>
					</div>
					<!-- /.table-responsive -->

				</div>
			</div>
		</div>
	</div>
</div>
