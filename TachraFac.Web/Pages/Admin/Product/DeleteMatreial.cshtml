@page "{id}"
@model TachraFac.Web.Pages.Admin.Product.DeleteMatreialModel
@{
	ViewData["Title"] = "حذف مواد اولیه";
}
<div id="page-wrapper">
	<div class="row">
		<div class="col-lg-12">
			<h1 class="page-header">حذف</h1>
		</div>
		<!-- /.col-lg-12 -->
	</div>

	<div class="row">
		<div class="col-lg-12">
			<div class="panel panel-default">
				<div class="panel-heading">
					اطلاعات ماده اولیه در حال حذف
				</div>
				<!-- /.panel-heading -->
				<div class="panel-body">
					<form method="post">
						<h3>آیا "@Model.rawMaterial.MaterialTitle" را حذف می کنید؟</h3>
						<input type="submit" value="حذف" class="btn btn-danger" />
						<button asp-page="AddMatreial" class="btn btn-info">انصراف</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

