@* @model TachraFac.Core.DTOs.UserProfileViewModel *@

<div class="container mt-4">

    <div class="row g-4">

        <!-- Profile Card -->
        <div class="col-lg-4 col-md-5">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">پروفایل کاربری</h5>
                </div>

                <div class="card-body text-center">

                    <!-- Profile Image -->
                    <img src="/UserImages/Model.ProfileImage"
                         class="rounded-circle mb-3"
                         style="width: 130px; height: 130px; object-fit: cover;" />

                    <h5 class="mb-3">Model.UserName</h5>

                    <hr />

                    <div class="text-start">

                        <p><strong>ایمیل:</strong> Model.Email</p>
                        <p><strong>شماره موبایل:</strong> Model.PhoneNumber</p>
                        <p><strong>کد پستی:</strong> Model.PostalCode</p>
                        <p><strong>آدرس:</strong> Model.Address</p>
                        <p><strong>تاریخ عضویت:</strong> Model.RegisterDate.ToString("yyyy/MM/dd")</p>

                    </div>

                    <a href="/UserPanel/Home/EditProfile" class="btn btn-success w-100 mt-3">
                        ویرایش اطلاعات
                    </a>

                </div>

            </div>

        </div>

        <!-- Dashboard -->
        <div class="col-lg-8 col-md-7">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">میز کار</h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <!-- Example Widget -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <h6 class="fw-bold">سفارش‌های اخیر</h6>
                                <p class="text-muted small">در این بخش می‌تونی سفارش‌های اخیرت رو ببینی.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <h6 class="fw-bold">پیام‌ها</h6>
                                <p class="text-muted small">پیام‌های جدید و اعلان‌ها اینجا نمایش داده می‌شن.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <h6 class="fw-bold">کیف پول</h6>
                                <p class="text-muted small">موجودی فعلی: <strong>@Model.Wallet تومان</strong></p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <h6 class="fw-bold">تنظیمات حساب</h6>
                                <p class="text-muted small">برای تغییر رمز عبور یا تنظیمات امنیتی.</p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
