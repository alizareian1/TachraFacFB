@using TachraFac.Core.DTOs
@model ChangePasswordViewModel
@{
	ViewData["Title"] = "تغییر کلمه عبور ";
}

<div class="container">
    <div class="row">
        <div class="col-10 col-md-7 col-lg-5 signup-login-box">
            <!-- start signup & login box -->
            <img src="assets/images/logo.png">
            <form asp-action="ChangePassword" method="post">
                @if(ViewBag.IsSuccess != null){
                    <div class="alert alert-success">
                        <p>کلمه عبور شما با موفقیت تغییر یافت</p>
                    </div>
                }

                <div class="input-group signup-login-form password">
                    <!-- start password input -->
                    <input type="password" asp-for="OldPassword" class="form-control form-control-lg signup-login-input" placeholder="رمز عبور فعلی">
                </div><!-- end password input -->

                <div class="input-group signup-login-form password">
                    <!-- start password input -->
                    <input type="password" asp-for="Password" class="form-control form-control-lg signup-login-input" placeholder="رمز عبور جدید">
                </div><!-- end password input -->

                <div class="input-group signup-login-form password">
                    <!-- start password input -->
                    <input type="password" asp-for="RePassword" class="form-control form-control-lg signup-login-input" placeholder="تکرار رمز عبور ">
                </div><!-- end password input -->
                
                <div class="text-danger" asp-validation-summary="All"></div>
                <button type="submit" class="btn btn-danger d-block font-12 mx-auto mb-4 remember-btn">
                    <!-- remember btn -->
                    ذخیره
                </button>

            </form>
        </div><!-- end signup & login box -->
    </div>
</div>