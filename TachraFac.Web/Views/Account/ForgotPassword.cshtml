@using TachraFac.Core.DTOs
@model ForgotPasswordViewModel

@* ﻿@model TachraFac.Core.DTOs.ForgotPasswordViewModel *@

@{
	ViewData["Title"] = "بازیابی کلمه عبور";
}



<div class="container">

<div class="owl-carousel-item position-relative">
    <img class="img-fluid" src="~/img/carousel-123.jpg" alt="Freshly Baked Bread">
    <div class="owl-carousel-inner">
        <div class="container">
            <div class="row justify-content-start">
                @* <div class="col-lg-8">
                    <p class="text-primary text-uppercase fw-bold mb-2">// Freshly Baked Every Day</p>
                    <h1 class="display-1 text-light mb-4 animated slideInDown">Taste the Difference</h1>
                    <p class="text-light fs-5 mb-4 pb-3">Discover the perfect blend of tradition and flavor with our artisan baked goods.</p>
                    <a href="#products" class="btn btn-primary rounded-pill py-3 px-5">Explore Now</a>
                </div> *@
            </div>
        </div>
    </div>
</div>

<div class="register-containerr">

    @if (ViewBag.IsSuccess != null)
    {
        <div class="alert alert-success">
            <p class="help-block">ایمیل بازیابی کلمه عبور برای شما ارسال شد</p>
        </div>


    }
    <div class="row">
        <div class="col-10 col-md-7 col-lg-5 signup-login-box">
            <!-- start signup & login box -->
            <img src="assets/images/logo.png">
            <p>بازیابی کلمه عبور</p>
            <form asp-action="ForgotPassword" method="post">

                <div class="input-group signup-login-form mobile-number">
                    <!-- start mobile number input -->
                    <input asp-for=UserName type="text" class="form-control form-control-lg signup-login-input" placeholder="نام کاربری ">
                </div><!-- end mobile number input -->

                <button type="submit" class="btn btn-danger d-block font-12 mx-auto mb-4 remember-btn">
                    <!-- remember btn -->
                    بازیابی
                </button>

                <p>کاربر جدید هستید؟ <a href="signup.html" class="underline">ثبت‌ نام در نیک کالا </a></p>

            </form>
        </div><!-- end signup & login box -->
    </div>

    
    <h2>بازیابی کلمه عبور</h2>
    <form asp-action="ForgotPassword" method="post">
        <div class="input-group">
            <label>نام کاربری</label>

            <span class="input-group-addon" id="email-address"><i class="zmdi zmdi-email"></i></span>
            <input asp-for="UserName" type="text" placeholder="نام کاربری ">
        </div>
        <span asp-validation-for="UserName"></span>       
        <button type="submit" class="btn btn-success" value="تایید و ارسال">تایید و ارسال</button>
    </form>

</div>
