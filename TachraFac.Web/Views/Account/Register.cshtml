<!-- Register Form -->
<div class="register-containerr">
    <h2>ثبت نام</h2>

    <form asp-action="Register" method="post">
        <div class="input-group">
            <label>نام کاربری</label>
            <input asp-for="UserName" type="text" placeholder="نام کاربری ">
        </div>


        <div class="input-group">
            <label>ایمیل</label>
            <input asp-for="Email" type="email" placeholder="ایمیل">
        </div>

        <div class="input-group">
            <label>رمز عبور</label>
            <input asp-for="Password" type="password" placeholder="رمز عبور">
         </div>
           

        
        <div class="input-group">
            <label>تکرار رمز عبور</label>
            <input asp-for="RePassword"  type="password" placeholder="تکرار رمز عبور">
        </div>
        

        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-success" value="ثبت نام">ثبت نام</button>
    </form>

    <p class="login-linkk">حساب دارید؟ <a href="/Login">ورود</a></p>
