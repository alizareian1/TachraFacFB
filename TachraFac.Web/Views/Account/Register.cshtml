
﻿@using TachraFac.Core.DTOs
@model RegisterViewModel



@{
	ViewData["Title"] = "ثبت نام";
}


<div class="container">
    <div class="row">
        <div class="col-10 col-md-7 col-lg-5 signup-login-box">
            <!-- start signup & login box -->
            <img src="assets/images/logo.png">
            <form asp-action="register" method="post">

                <div class="input-group signup-login-form text">
                    <!-- start username input -->
                    <input asp-for="UserName" type="text" class="form-control form-control-lg signup-login-input" placeholder="نام کاربری ">
                </div><!-- end username input -->

                <div class="input-group signup-login-form text">
                    <!-- start username input -->
                    <input  asp-for="Name"  type="text" class="form-control form-control-lg signup-login-input" placeholder="نام و نام خانوادگی ">
                </div><!-- end username input -->

                <div class="input-group signup-login-form email-box">
                    <!-- start email input -->
                    <input asp-for="Email" type="text" class="form-control form-control-lg signup-login-input" placeholder="ایمیل ">
                </div><!-- end email input -->

                <div class="input-group signup-login-form address-box">
                    <!-- start address input -->
                    <input asp-for="Address" type="text" class="form-control form-control-lg signup-login-input" placeholder="آدرس ">
                </div><!-- end address input -->

                <div class="input-group signup-login-form ">
                    <!-- start mobile postalCod input -->
                    <input asp-for="PostalCode" type="tel" class="form-control form-control-lg signup-login-input" placeholder="کد پستی">
                </div><!-- end mobile postalCod input -->

                <div class="input-group signup-login-form mobile-number">
                    <!-- start mobile number input -->
                    <input asp-for="Mobile" type="tel" class="form-control form-control-lg signup-login-input" placeholder="شماره موبایل">
                </div><!-- end mobile number input -->

                <div class="input-group signup-login-form password">
                    <!-- start password input -->
                    <input asp-for="Password" type="password" class="form-control form-control-lg signup-login-input" placeholder="رمز عبور ">
                </div><!-- end password input -->

                <div class="input-group signup-login-form password">
                    <!-- start Repassword input -->
                    <input asp-for="RePassword" type="password" class="form-control form-control-lg signup-login-input" placeholder="رمز عبور ">
                </div><!-- end Repassword input -->
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="signup-login-form">
                    <div class="form-check text-center">
                        <!-- start input check -->
                        <input class="form-check-input form-check-input-custom" type="checkbox" id="customCheck" checked>
                        <label class="form-check-label line-height" for="customCheck">
                            <a href="#" class="underline">حریم خصوصی</a> و <a href="#" class="underline">شرایط و قوانین</a> استفاده از سرویس های سایت  تچرا را مطالعه نموده و با کلیه موارد آن موافقم.
                        </label>
                    </div><!-- end input check -->
                </div>

                <button type="submit" class="btn btn-danger d-block font-12 mx-auto signup-btn mb-4">
                    <!-- signup btn -->
                    ثبت نام
                </button>

                <p>قبلا در نیک کالا ثبت‌ نام کرده‌اید؟ <a href="login.html" class="underline">وارد شویــد</a></p>

            </form>
        </div><!-- end signup & login box -->
    </div>
</div>


